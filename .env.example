# Travel Monitor 2.0 Configuration Template
APP_NAME="Travel Monitor 2.0"
APP_ENV=development

# Database Configuration
# Local SQLite (default for instant setup):
DATABASE_URL="sqlite+aiosqlite:///./travel_monitor_v2.db"
# Docker / Production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://tm_admin:tm_secret_2026@localhost:5432/travel_monitor_v2"

# Redis Cache (optional)
REDIS_URL="redis://localhost:6379/0"

# Security
SECRET_KEY="development-secret-key-change-in-production-2026"

# Crawler Settings
SCRAPER_TIMEOUT_SECONDS=12.0
CACHE_SEARCH_TTL_SECONDS=7200
